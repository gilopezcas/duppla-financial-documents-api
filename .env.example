# Entorno
ENV=development

# Base de datos (ejemplo Postgres o SQLite)
# Para local con SQLite: sqlite:///./db.sqlite
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dupla_db
# Nombre usado en el código (contiene typo histórico en este repo)
DATEBASE_URL=postgresql://postgres:postgres@localhost:5432/dupla_db

# Servidor
HOST=127.0.0.1
PORT=8000

# Seguridad
SECRET_KEY=changeme
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limiting (in-memory/redis)
RATE_LIMIT_CALLS=10
RATE_LIMIT_PERIOD=60
REDIS_URL=redis://localhost:6379/0

# Logs
LOG_LEVEL=info

# Otras variables útiles
POOL_SIZE=5